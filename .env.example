# Copy this file to .env and paste your key. .env is ignored by git.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional agent budgets
RD_MAX_TRIALS=3
RD_MAX_STEPS=8
RD_MAX_LLM_CALLS=30

# Optional sandbox limits
RD_WALL_TIMEOUT=30
RD_TEST_TIMEOUT=4
RD_CPU_LIMIT=20
RD_MEMORY_MB=512
RD_HYPOTHESIS_EXAMPLES=150
